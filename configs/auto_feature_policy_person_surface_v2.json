    "visible_skin_tone", "skin_exposure", "clothing", "scene",
    "occlusion", "truncation"
  ],
  "person_feature_groups": [
    "visibility", "face", "orientation", "pose", "action", "interaction",
    "hair", "skin_surface", "clothing", "accessories", "scene", "occlusion",
